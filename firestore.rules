rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // >>> PUT YOUR ADMIN EMAIL HERE (same as in config.js) <<<
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['admin@demo.com'];
    }
    function signedIn() { return request.auth != null; }
    function wheel(wid) { return get(/databases/$(database)/documents/wheels/$(wid)).data; }

    // Wheels (prize, price, Whish number, draw time, draw result): everyone reads, only admin writes
    match /wheels/{wid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Account profiles: each user writes his own, admin reads all
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    // Numbers (id = wheelId_n): a user can reserve a FREE number (pending) for himself only,
    // only while the wheel has no draw. Only the admin confirms (paid) or removes.
    match /numbers/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.n is int
        && id == request.resource.data.wheelId + '_' + string(request.resource.data.n)
        && request.resource.data.n >= 1
        && request.resource.data.n <= wheel(request.resource.data.wheelId).totalNumbers
        && wheel(request.resource.data.wheelId).draw == null;
      allow update, delete: if isAdmin();
    }

    // Whish payment reference of a reservation: owner + admin only
    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
